# Discord Bot
DISCORD_BOT_TOKEN=seu_token_do_discord_aqui
DISCORD_OWNER_ID=seu_id_numerico_do_discord
DISCORD_OWNER_NAMES=Macaco Opressor,anakin opressor,Lucas,lucasaosf

# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui
TELEGRAM_OWNER_CHAT_ID=seu_chat_id_do_telegram

# Provedor de IA (ollama / openai_compatible / local)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Voz e Síntese (Edge-TTS)
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Caminho Raiz dos Projetos
PROJECTS_ROOT=C:\Users\Lucas Aosf\Documents\!!!___ANTIGRAVITY___!!!
